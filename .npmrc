# Reject packages younger than 14 days
min-release-age=14
# Skip lifecycle scripts — top npm-supply-chain malware vector
ignore-scripts=true
# Enforce engines.node / engines.npm instead of warning
engine-strict=true
# `npm install <pkg>` pins exact versions, no caret drift
save-exact=true
# Lockfile changes must be intentional
package-lock=true
